{
  "name": "daruma-core",
  "version": "0.1.1",
  "description": "Pure domain layer for Daruma: failure classification, channel health (circuit breaker), and recovery policy decision engine. Zero Node runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "SISCHOI",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "keywords": [
    "daruma",
    "resilience",
    "failover",
    "circuit-breaker",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SISCHOI/daruma.git",
    "directory": "packages/daruma-core"
  },
  "homepage": "https://github.com/SISCHOI/daruma#readme",
  "bugs": {
    "url": "https://github.com/SISCHOI/daruma/issues"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
